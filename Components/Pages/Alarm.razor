@page "/alarm"
@inject AlarmService Service
<h1 class="mb-6 text-2xl font-semibold">Alarm</h1>
<div class="mb-6 flex flex-col items-start gap-4">
    <label>Alarm time <input aria-label="Alarm time" type="time" class="ml-2 rounded border border-slate-300 p-2" value="@time" @onchange="e => time = e.Value?.ToString() ?? string.Empty" /></label>
    <WeekdayPicker @bind-Days="days" />
    <button class="rounded bg-blue-700 px-4 py-2 text-white" @onclick="AddAlarm">Add alarm</button>
    @if (error is not null) { <p role="alert" class="text-red-700">@error</p> }
    <p class="text-sm text-slate-600">Choose the days for a weekly alarm, or leave all days unchecked for a one-time alarm.</p>
</div>
@if (Service.Items.Count == 0) { <p class="text-slate-600">No alarms. Add an alarm above.</p> }
<div class="flex flex-col gap-4">
    @foreach (var alarm in Service.Items)
    {
        <section @key="alarm.Id" class="rounded border border-slate-200 bg-white p-4" aria-label="@($"Alarm {alarm.Number}")">
            <h2 class="mb-2 text-lg font-semibold">Alarm @alarm.Number</h2>
            <p class="text-3xl font-mono">@alarm.Time.ToString("HH:mm")</p>
            <p class="my-2">Scheduled: @alarm.ScheduledAt.ToString("ddd, d MMMM, HH:mm")</p>
            <div class="my-3"><WeekdayPicker Days="alarm.Days" DaysChanged="alarm.SetDays" /></div>
            <p role="status" class="mb-3">Status: @alarm.State</p>
            <div class="flex flex-wrap gap-2">
                @if (alarm.State == AlarmState.Triggered)
                {
                    <button class="rounded border border-slate-300 px-4 py-2" @onclick="alarm.Dismiss">Dismiss</button>
                }
                @if (alarm.State == AlarmState.Disabled)
                {
                    <button class="rounded border border-slate-300 px-4 py-2" @onclick="alarm.Enable">Enable</button>
                }
                else
                {
                    <button class="rounded border border-slate-300 px-4 py-2" @onclick="alarm.Disable">Disable</button>
                }
                <button class="rounded border border-slate-300 px-4 py-2" @onclick="() => Service.Remove(alarm.Id)">Remove</button>
            </div>
        </section>
    }
</div>
@code {
    [CascadingParameter] public long Revision { get; set; }
    private string time = DateTime.Now.AddMinutes(1).ToString("HH:mm");
    private string? error;
    private AlarmDays days;
    private void AddAlarm()
    {
        if (!TimeOnly.TryParse(time, out var selected)) { error = "Choose a valid time."; return; }
        error = null;
        Service.Add(selected, days);
    }
}
