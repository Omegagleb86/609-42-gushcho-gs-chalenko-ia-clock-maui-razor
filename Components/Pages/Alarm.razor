@page "/alarm"
@inject AlarmService Service
@{ var next = Service.NextAlarm; }
<section class="mx-auto w-full max-w-xl text-center">
    <h1 class="mb-5 text-xs font-semibold uppercase tracking-[0.2em] text-muted">Ближайший будильник</h1>
    <div class="text-[clamp(3rem,9vw,6.5rem)] font-bold leading-none tracking-tight tabular-nums">@(next?.Time.ToString("HH:mm") ?? "--:--")</div>
    <p class="mt-5 text-sm text-muted sm:text-lg">@(next is null ? "Нет активных будильников" : $"Через {TimeDisplay.FormatUntil(next.TimeUntil)}")</p>
    <button class="primary-button mt-8" aria-expanded="@(adding ? "true" : "false")" @onclick="() => adding = !adding">+ Добавить будильник</button>
    @if (adding)
    {
        <div class="mt-6 rounded-3xl border border-white/5 bg-panel p-5">
            <label class="block text-xs text-muted">Время
                <input aria-label="Время нового будильника" type="time" class="text-field mx-auto mt-3 block max-w-full text-center text-3xl" value="@time" @onchange="e => time = e.Value?.ToString() ?? string.Empty" />
            </label>
            <div class="mt-5"><WeekdayPicker @bind-Days="days" /></div>
            @if (error is not null) { <p role="alert" class="mt-3 text-sm text-rose-300">@error</p> }
            <div class="mt-5 flex flex-wrap justify-center gap-2">
                <button class="primary-button" @onclick="AddAlarm">Добавить</button>
                <button class="action-button" @onclick="() => adding = false">Отмена</button>
            </div>
        </div>
    }
    <div class="mt-10 flex flex-col gap-4 text-left">
        @foreach (var alarm in Service.Items) { <AlarmCard @key="alarm.Id" Alarm="alarm" OnRemove="Service.Remove" /> }
    </div>
</section>
@code {
    [CascadingParameter] public long Revision { get; set; }
    private bool adding;
    private string time = DateTime.Now.AddMinutes(1).ToString("HH:mm");
    private string? error;
    private AlarmDays days;
    private void AddAlarm()
    {
        if (!TimeOnly.TryParse(time, out var selected)) { error = "Выберите корректное время."; return; }
        Service.Add(selected, days); adding = false; error = null;
    }
}
