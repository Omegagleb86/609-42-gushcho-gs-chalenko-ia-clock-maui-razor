@page "/alarm"
@inject AlarmService Service
<h1 class="mb-6 text-2xl font-semibold">Alarm</h1>
<div class="flex flex-col items-start gap-4">
    <label>Alarm time <input aria-label="Alarm time" type="time" class="ml-2 rounded border border-slate-300 p-2" value="@time" @onchange="e => time = e.Value?.ToString() ?? string.Empty" /></label>
    <div class="flex gap-2">
        <button class="rounded bg-blue-700 px-4 py-2 text-white" @onclick="SetAlarm">Set Alarm</button>
        <button class="rounded border border-slate-300 px-4 py-2 disabled:opacity-50" disabled="@(Service.State == AlarmState.Disabled)" @onclick="Service.Disable">Disable</button>
    </div>
    @if (error is not null) { <p role="alert" class="text-red-700">@error</p> }
    <p role="status">Status: @Service.State</p>
    <p>Alarm: @(Service.ScheduledAt?.ToString("HH:mm, d MMMM") ?? "Not set")</p>
    <p class="text-sm text-slate-600">A past time is scheduled for tomorrow. Keep the app open to receive the alert.</p>
</div>
@code {
    [CascadingParameter] public long Revision { get; set; }
    private string time = DateTime.Now.AddMinutes(1).ToString("HH:mm");
    private string? error;
    private void SetAlarm()
    {
        if (!TimeOnly.TryParse(time, out var selected)) { error = "Choose a valid time."; return; }
        error = null;
        Service.Set(selected);
    }
}
