@page "/timer"
@inject TimerService Service
<h1 class="mb-6 text-2xl font-semibold">Timer</h1>
<div class="text-5xl font-mono tabular-nums">@TimeDisplay.Format(Service.Remaining, true)</div>
<fieldset disabled="@(Service.State is RunState.Running or RunState.Paused)" class="my-6 flex flex-wrap gap-3">
    <label>Hours <input type="number" min="0" max="999" class="w-20 rounded border border-slate-300 p-2" @bind="hours" /></label>
    <label>Minutes <input type="number" min="0" max="59" class="w-20 rounded border border-slate-300 p-2" @bind="minutes" /></label>
    <label>Seconds <input type="number" min="0" max="59" class="w-20 rounded border border-slate-300 p-2" @bind="seconds" /></label>
</fieldset>
<div class="flex flex-wrap gap-2">
    <button class="rounded bg-blue-700 px-4 py-2 text-white disabled:opacity-50" disabled="@(Service.State is RunState.Running or RunState.Paused)" @onclick="Start">Start</button>
    <button class="rounded border border-slate-300 px-4 py-2 disabled:opacity-50" disabled="@(Service.State is not (RunState.Running or RunState.Paused))" @onclick="TogglePause">@(Service.State == RunState.Paused ? "Resume" : "Pause")</button>
    <button class="rounded border border-slate-300 px-4 py-2" @onclick="Reset">Reset</button>
</div>
<p role="status" class="mt-4">Status: @Service.State</p>
@if (error is not null) { <p role="alert" class="text-red-700">@error</p> }
@code {
    [CascadingParameter] public long Revision { get; set; }
    private int hours, minutes = 5, seconds;
    private string? error;
    private void Start()
    {
        if (hours is < 0 or > 999 || minutes is < 0 or > 59 || seconds is < 0 or > 59 || hours + minutes + seconds == 0)
        { error = "Enter a positive duration (hours 0–999, minutes and seconds 0–59)."; return; }
        error = null;
        Service.Start(new TimeSpan(hours, minutes, seconds));
    }
    private void TogglePause() { if (Service.State == RunState.Paused) Service.Resume(); else Service.Pause(); }
    private void Reset() { Service.Reset(); error = null; }
}
