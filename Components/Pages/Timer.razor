@page "/timer"
@inject TimerService Service
<h1 class="mb-6 text-2xl font-semibold">Timer</h1>
<fieldset class="my-6 flex flex-wrap gap-3">
    <legend class="text-base">New timer duration</legend>
    <label>Hours <input type="number" min="0" max="999" class="w-20 rounded border border-slate-300 p-2" @bind="hours" /></label>
    <label>Minutes <input type="number" min="0" max="59" class="w-20 rounded border border-slate-300 p-2" @bind="minutes" /></label>
    <label>Seconds <input type="number" min="0" max="59" class="w-20 rounded border border-slate-300 p-2" @bind="seconds" /></label>
</fieldset>
<button class="mb-4 rounded bg-blue-700 px-4 py-2 text-white" @onclick="AddTimer">Add timer</button>
@if (error is not null) { <p role="alert" class="mb-4 text-red-700">@error</p> }
@if (Service.Items.Count == 0) { <p class="text-slate-600">No timers. Add a timer above.</p> }
<div class="flex flex-col gap-4">
    @foreach (var timer in Service.Items)
    {
        <section @key="timer.Id" class="rounded border border-slate-200 bg-white p-4" aria-label="@($"Timer {timer.Number}")">
            <h2 class="mb-2 text-lg font-semibold">Timer @timer.Number</h2>
            <div class="mb-4 text-4xl font-mono tabular-nums">@TimeDisplay.Format(timer.Remaining, true)</div>
            <div class="flex flex-wrap gap-2">
                <button class="rounded bg-blue-700 px-4 py-2 text-white disabled:opacity-50" disabled="@(timer.State is RunState.Running or RunState.Paused)" @onclick="timer.Start">Start</button>
                <button class="rounded border border-slate-300 px-4 py-2 disabled:opacity-50" disabled="@(timer.State is not (RunState.Running or RunState.Paused))" @onclick="() => TogglePause(timer)">@(timer.State == RunState.Paused ? "Resume" : "Pause")</button>
                <button class="rounded border border-slate-300 px-4 py-2" @onclick="timer.Reset">Reset</button>
                <button class="rounded border border-slate-300 px-4 py-2" @onclick="() => Service.Remove(timer.Id)">Remove</button>
            </div>
            <p role="status" class="mt-3">Status: @timer.State</p>
        </section>
    }
</div>
@code {
    [CascadingParameter] public long Revision { get; set; }
    private int hours, minutes = 5, seconds;
    private string? error;
    private void AddTimer()
    {
        if (hours is < 0 or > 999 || minutes is < 0 or > 59 || seconds is < 0 or > 59 || hours + minutes + seconds == 0)
        { error = "Enter a positive duration (hours 0–999, minutes and seconds 0–59)."; return; }
        error = null;
        Service.Add(new TimeSpan(hours, minutes, seconds));
    }
    private static void TogglePause(TimerEntry timer) { if (timer.State == RunState.Paused) timer.Resume(); else timer.Pause(); }
}
