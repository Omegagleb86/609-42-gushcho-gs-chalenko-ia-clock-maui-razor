@page "/timer"
@inject TimerService Service
<section class="mx-auto w-full max-w-xl text-center">
    <h1 class="mb-6 text-xs font-semibold uppercase tracking-[0.2em] text-muted">Таймер</h1>
    @if (Service.Items.Count == 0) { <p class="my-8 text-muted">Добавьте первый таймер</p> }
    <div class="flex flex-col gap-4">
        @foreach (var timer in Service.Items.OrderBy(item => item.State == RunState.Running ? 0 : item.State == RunState.Paused ? 1 : item.State == RunState.Finished ? 2 : 3))
        {
            <article @key="timer.Id" class="rounded-3xl border border-white/5 bg-panel p-5 sm:p-8" aria-label="@($"Таймер на {TimeDisplay.Format(timer.Duration)}")">
                <div class="text-[clamp(2rem,7vw,4.5rem)] font-bold leading-none tracking-tight tabular-nums">@TimeDisplay.Format(timer.Remaining, true)</div>
                <p class="mt-4 text-xs text-muted">Таймер на @TimeDisplay.Format(timer.Duration) · @StateLabels.Run(timer.State)</p>
                <div class="mt-6 flex flex-wrap justify-center gap-2">
                    @if (timer.State is RunState.Stopped or RunState.Finished) { <button class="primary-button" @onclick="timer.Start">Начать</button> }
                    @if (timer.State is RunState.Running or RunState.Paused) { <button class="action-button" @onclick="() => TogglePause(timer)">@(timer.State == RunState.Paused ? "Продолжить" : "Пауза")</button> }
                    <button class="action-button" @onclick="timer.Reset">Сбросить</button>
                    <button class="action-button text-rose-300" @onclick="() => Service.Remove(timer.Id)">Удалить</button>
                </div>
            </article>
        }
    </div>
    <button class="primary-button mt-8" aria-expanded="@(adding ? "true" : "false")" @onclick="() => adding = !adding">+ Добавить таймер</button>
    @if (adding)
    {
        <div class="mt-6 rounded-3xl border border-white/5 bg-panel p-5">
            <fieldset class="flex flex-wrap justify-center gap-3">
                <legend class="mb-4 text-xs text-muted">Длительность</legend>
                <label class="text-xs text-muted">Часы <input type="number" min="0" max="999" class="text-field mt-2 block w-16 text-center sm:w-20" @bind="hours" /></label>
                <label class="text-xs text-muted">Минуты <input type="number" min="0" max="59" class="text-field mt-2 block w-16 text-center sm:w-20" @bind="minutes" /></label>
                <label class="text-xs text-muted">Секунды <input type="number" min="0" max="59" class="text-field mt-2 block w-16 text-center sm:w-20" @bind="seconds" /></label>
            </fieldset>
            @if (error is not null) { <p role="alert" class="mt-3 text-sm text-rose-300">@error</p> }
            <div class="mt-5 flex flex-wrap justify-center gap-2">
                <button class="primary-button" @onclick="AddTimer">Запустить таймер</button>
                <button class="action-button" @onclick="() => adding = false">Отмена</button>
            </div>
        </div>
    }
</section>
@code {
    [CascadingParameter] public long Revision { get; set; }
    private bool adding;
    private int hours, minutes = 5, seconds;
    private string? error;
    private void AddTimer()
    {
        if (hours is < 0 or > 999 || minutes is < 0 or > 59 || seconds is < 0 or > 59 || hours + minutes + seconds == 0)
        { error = "Введите длительность: часы 0–999, минуты и секунды 0–59."; return; }
        var timer = Service.Add(new TimeSpan(hours, minutes, seconds)); timer.Start(); adding = false; error = null;
    }
    private static void TogglePause(TimerEntry timer) { if (timer.State == RunState.Paused) timer.Resume(); else timer.Pause(); }
}
