@page "/stopwatch"
@inject StopwatchService Service
<section class="mx-auto w-full max-w-xl text-center">
    <h1 class="mb-6 text-xs font-semibold uppercase tracking-[0.2em] text-muted">Секундомер</h1>
    <div class="text-[clamp(2.5rem,8vw,6rem)] font-bold leading-none tracking-tight tabular-nums">@TimeDisplay.Format(Service.Elapsed)</div>
    <p class="mt-3 text-2xl tabular-nums text-muted">.@Service.Elapsed.Milliseconds.ToString("000")</p>
    <button class="mx-auto mt-8 flex h-28 w-28 items-center justify-center rounded-full bg-violet-500 outline-none hover:bg-violet-400 focus-visible:ring-4 focus-visible:ring-violet-300/40 disabled:cursor-default disabled:bg-violet-500/20" disabled="@(Service.State == RunState.Running)" aria-label="@(Service.State == RunState.Paused ? "Продолжить секундомер" : "Запустить секундомер")" @onclick="StartOrResume">
        <img src="icons/play.svg" alt="" class="ml-1 h-9 w-8" />
    </button>
    <p role="status" class="mt-4 text-xs text-muted">@StateLabels.Run(Service.State)</p>
    <div class="mt-7 flex flex-wrap justify-center gap-2">
        <button class="action-button" disabled="@(Service.State is not (RunState.Running or RunState.Paused))" @onclick="TogglePause">@(Service.State == RunState.Paused ? "Продолжить" : "Пауза")</button>
        <button class="action-button" disabled="@(Service.State != RunState.Running)" @onclick="Service.Capture">Фиксация</button>
        <button class="action-button" @onclick="Service.Reset">Сбросить</button>
    </div>
    @if (Service.Marks.Count > 0)
    {
        <section class="mt-10" aria-label="Фиксации времени">
            <h2 class="mb-4 text-xs uppercase tracking-widest text-muted">Фиксации</h2>
            <ol class="flex flex-col gap-2" aria-live="polite" aria-relevant="additions">
                @foreach (var mark in Service.Marks)
                {
                    <li @key="mark.Number" class="flex items-center justify-between rounded-2xl bg-panel px-5 py-4">
                        <span class="text-sm text-muted">@mark.Number.ToString("00")</span>
                        <span class="font-semibold tabular-nums">@TimeDisplay.FormatPrecise(mark.Elapsed)</span>
                    </li>
                }
            </ol>
        </section>
    }
</section>
@code {
    [CascadingParameter] public long Revision { get; set; }
    private void StartOrResume() { if (Service.State == RunState.Paused) Service.Resume(); else Service.Start(); }
    private void TogglePause() { if (Service.State == RunState.Paused) Service.Resume(); else Service.Pause(); }
}
