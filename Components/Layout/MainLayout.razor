@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject ClockService Clock
@inject AlarmService Alarm
@inject TimerService Timer
@inject StopwatchService Stopwatch
@inject AlertAudioService Audio
@inject TimeStateStore Store

<div class="flex min-h-screen bg-ink font-sans text-white">
    <aside class="sticky top-0 flex h-screen w-24 shrink-0 flex-col bg-rail px-2 sm:w-44 sm:px-4">
        <div class="flex h-32 shrink-0 justify-center pt-8">
            <button class="@(Audio.Enabled ? "bg-pink-500 hover:bg-pink-400" : "bg-violet-500 hover:bg-violet-400") flex h-12 w-12 items-center justify-center rounded-full outline-none focus-visible:ring-2 focus-visible:ring-white/60 disabled:opacity-40" disabled="@(!Audio.Ready || Audio.Changing)" aria-pressed="@(Audio.Enabled ? "true" : "false")" aria-label="@(Audio.Enabled ? "Выключить звук" : "Включить звук")" title="@(Audio.Enabled ? "Выключить звук" : "Включить звук")" @onclick="Audio.ToggleAsync">
                <img src="@(Audio.Enabled ? "icons/with_sound.svg" : "icons/without_sound.svg")" alt="" class="h-5 w-6 object-contain" />
            </button>
        </div>
        <NavMenu />
    </aside>
    <main class="flex min-h-screen min-w-0 flex-1 items-center justify-center px-4 py-10 sm:px-8">
        <div class="w-full max-w-3xl">
            @if (Store.Error is not null) { <p role="alert" class="mb-6 rounded-2xl bg-rose-500/10 p-4 text-sm text-rose-300">@Store.Error</p> }
            @if (Audio.Error is not null) { <p role="alert" class="mb-6 rounded-2xl bg-rose-500/10 p-4 text-sm text-rose-300">@Audio.Error</p> }
            @foreach (var alarm in Alarm.Items.Where(item => item.State == AlarmState.Triggered))
            {
                <div @key="alarm.Id" role="alert" class="mb-4 flex flex-wrap items-center justify-between gap-3 rounded-2xl bg-violet-500/15 p-4 text-sm">
                    <span>Будильник на @alarm.ScheduledAt.ToString("HH:mm") сработал</span>
                    <button class="action-button" @onclick="alarm.Dismiss">Остановить</button>
                </div>
            }
            @foreach (var timer in Timer.Items.Where(item => item.State == RunState.Finished))
            {
                <div @key="timer.Id" role="alert" class="mb-4 flex flex-wrap items-center justify-between gap-3 rounded-2xl bg-pink-500/15 p-4 text-sm">
                    <span>Таймер на @TimeDisplay.Format(timer.Duration) завершён</span>
                    <button class="action-button" @onclick="timer.Reset">Закрыть</button>
                </div>
            }
            @if (loaded) { <CascadingValue Value="revision">@Body</CascadingValue> }
            else { <p role="status" class="text-center text-sm text-muted">Восстанавливаем будильники и таймеры…</p> }
        </div>
    </main>
</div>

@code {
    private readonly CancellationTokenSource cancellation = new();
    private Task? refreshTask;
    private Task? loadTask;
    private bool loaded;
    private long revision;
    private bool disposed;

    protected override async Task OnInitializedAsync()
    {
        loadTask = Store.InitializeAsync();
        await loadTask;
        if (!disposed)
        {
            loaded = true;
            refreshTask = RefreshAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Audio.InitializeAsync();
        if (!disposed) StateHasChanged();
    }

    private async Task RefreshAsync()
    {
        using var ticker = new PeriodicTimer(TimeSpan.FromMilliseconds(100));
        try
        {
            while (await ticker.WaitForNextTickAsync(cancellation.Token))
            {
                await InvokeAsync(async () =>
                {
                    if (disposed) return;
                    Clock.Refresh();
                    Alarm.Refresh();
                    Timer.Refresh();
                    await Audio.SyncAsync(Alarm.Items, Timer.Items);
                    if (disposed) return;
                    revision++;
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        cancellation.Cancel();
        if (refreshTask is not null) await refreshTask;
        if (loadTask is not null) await loadTask;
        await Store.FlushAsync();
        Store.StopObserving();
        Timer.Clear();
        Stopwatch.Reset();
        Alarm.Clear();
        await Audio.DisposeAsync();
        cancellation.Dispose();
    }
}
