<g transform="@($"translate({X} 0)")">
    @for (var segment = 0; segment < Shapes.Length; segment++)
    {
        <polygon points="@Shapes[segment]" class="@(IsActive(segment) ? "segment-on" : "segment-off")" />
    }
</g>

@code {
    [Parameter] public char Value { get; set; }
    [Parameter] public int X { get; set; }

    private static readonly string[] Shapes =
    [
        "20,10 80,10 88,18 80,26 20,26 12,18",
        "82,28 90,20 98,28 98,78 90,86 82,78",
        "82,102 90,94 98,102 98,152 90,160 82,152",
        "20,154 80,154 88,162 80,170 20,170 12,162",
        "2,102 10,94 18,102 18,152 10,160 2,152",
        "2,28 10,20 18,28 18,78 10,86 2,78",
        "20,82 80,82 88,90 80,98 20,98 12,90"
    ];

    // Bit order: gfedcba. A dash lights only the middle segment.
    private static readonly int[] Masks =
    [0b0111111, 0b0000110, 0b1011011, 0b1001111, 0b1100110,
     0b1101101, 0b1111101, 0b0000111, 0b1111111, 0b1101111];

    private bool IsActive(int segment)
    {
        var mask = Value is >= '0' and <= '9' ? Masks[Value - '0']
            : Value == '-' ? 0b1000000 : 0;
        return (mask & (1 << segment)) != 0;
    }
}
